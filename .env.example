# Naver Search Ads (검색광고) API — 키워드 검색량/연관검색어
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# Naver Open API — 블로그/카페 검색, 지역검색 (블로그지수·콘텐츠 진단·발행량 계산에 사용)
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# Notion — 검색 세션/키워드 결과, 블로그지수 세션/결과, 문의 저장소
NOTION_TOKEN=
NOTION_SESSIONS_DB_ID=
NOTION_KEYWORDS_DB_ID=
NOTION_BLOG_SCORE_SESSIONS_DB_ID=
NOTION_BLOG_SCORE_RECORDS_DB_ID=
NOTION_INQUIRIES_DB_ID=
NOTION_KEYWORD_SNAPSHOTS_DB_ID=
NOTION_VISITS_DB_ID=
NOTION_SUBSCRIBERS_DB_ID=
NOTION_USERS_DB_ID=
NOTION_BOARD_POSTS_DB_ID=
NOTION_BOARD_COMMENTS_DB_ID=
NOTION_WRITE_HISTORY_DB_ID=
NOTION_BILLING_HISTORY_DB_ID=

# Resend — 문의하기(/contact) 이메일 발송 (resend.com 가입 후 API Keys에서 발급)
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# Anthropic (Claude API) — /write의 AI 블로그 글쓰기용. console.anthropic.com에서
# 발급 (Claude Code/Claude.ai 구독과 무관한 별도 과금 키).
ANTHROPIC_API_KEY=

# 네이버 로그인 — developers.naver.com 앱 등록 후 발급 (검색광고/오픈API 키와 별개).
# Redirect URI: https://ezzsearch.com/api/auth/naver/callback
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# 카카오 로그인 — developers.kakao.com 앱 등록 후 REST API 키 발급.
# Redirect URI: https://ezzsearch.com/api/auth/kakao/callback
# KAKAO_CLIENT_SECRET은 카카오 앱에서 Client Secret을 켰을 때만 필요.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 구글 로그인 — console.cloud.google.com에서 OAuth 클라이언트 ID 발급.
# Redirect URI: https://ezzsearch.com/api/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# /admin 접근 비밀번호 — 직접 정한 값으로 설정할 것
ADMIN_PASSWORD=

# Pixabay — /write의 추천 스톡 이미지 검색용 (선택 사항). pixabay.com 무료 가입 후
# https://pixabay.com/api/docs/ 에서 발급. 없으면 이 기능만 조용히 비활성화되고
# 나머지 글 생성 결과(제목/본문/태그)는 정상적으로 반환됨.
PIXABAY_API_KEY=

# OpenAI — /write의 AI 이미지 생성(제품 비교그래픽 등 실사진으로 대체 어려운
# 경우, gpt-image-1)용 (선택 사항). platform.openai.com에서 API 키 발급 +
# 결제수단 등록 필요 — 이미지 1장당 과금됨(Claude/Pixabay와 별개 비용).
# 없으면 이 기능만 조용히 비활성화되고 나머지 결과는 정상 반환됨.
OPENAI_API_KEY=

# 토스페이먼츠 정기결제(빌링) — /write 유료 한도·블로그지수 AI 인사이트 구독제용.
# developers.tosspayments.com에서 발급(사업자등록 없이도 테스트 키는 무료·즉시 발급).
# 실 서비스 전환 시 라이브 키로 교체(코드 변경 불필요).
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
