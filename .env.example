# Naver Search Ads (검색광고) API — 키워드 검색량/연관검색어
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# Naver Open API — 블로그/카페 검색, 지역검색 (블로그지수·콘텐츠 진단·발행량 계산에 사용)
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# Notion — 검색 세션/키워드 결과, 블로그지수 세션/결과, 문의 저장소
NOTION_TOKEN=
NOTION_SESSIONS_DB_ID=
NOTION_KEYWORDS_DB_ID=
NOTION_BLOG_SCORE_SESSIONS_DB_ID=
NOTION_BLOG_SCORE_RECORDS_DB_ID=
NOTION_INQUIRIES_DB_ID=

# Resend — 문의하기(/contact) 이메일 발송 (resend.com 가입 후 API Keys에서 발급)
RESEND_API_KEY=
CONTACT_EMAIL_TO=
